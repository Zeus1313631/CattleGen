{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron-vite/node"],
    "outDir": "out/types-node"
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "src/db/schema.ts",
    "src/types/**/*.ts"
  ]
}
