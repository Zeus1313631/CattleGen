  "dataSourceUrl": "https://www.angus.org/tools-resources/national-cattle-evaluation",
  "notes": "Angus marbling EPDs use the USDA scale (same as AWA-US). $C (Combined Value) is AAA's key all-purpose index for commercial producers retaining ownership through harvest.",
  "traits": [
    { "key": "CED",  "label": "Calving Ease Direct",       "unit": "%",   "higherIsBetter": true,  "category": "calving",    "description": "Expected % unassisted births from the sire to first-calf heifers.", "evaluationSystem": "EPD" },
    { "key": "BW",   "label": "Birth Weight",              "unit": "lbs", "higherIsBetter": false, "category": "calving",    "description": "Progeny birth-weight difference.", "evaluationSystem": "EPD" },
    { "key": "WW",   "label": "Weaning Weight",            "unit": "lbs", "higherIsBetter": true,  "category": "growth",     "description": "Progeny weight at ~205 days.", "evaluationSystem": "EPD" },
    { "key": "YW",   "label": "Yearling Weight",           "unit": "lbs", "higherIsBetter": true,  "category": "growth",     "description": "Progeny weight at ~365 days.", "evaluationSystem": "EPD" },
    { "key": "RADG", "label": "Residual Avg Daily Gain",   "unit": "lb/d","higherIsBetter": true,  "category": "efficiency", "description": "Feedlot efficiency — gain above what is predicted from intake.", "evaluationSystem": "EPD" },
    { "key": "DMI",  "label": "Dry Matter Intake",         "unit": "lb/d","higherIsBetter": false, "category": "efficiency", "description": "Feed intake difference. Lower at equal gain = better efficiency.", "evaluationSystem": "EPD" },
    { "key": "Milk", "label": "Maternal Milk",             "unit": "lbs", "higherIsBetter": true,  "category": "maternal",   "description": "Daughter's milk contribution to calf WW.", "evaluationSystem": "EPD" },
    { "key": "TM",   "label": "Total Maternal",            "unit": "lbs", "higherIsBetter": true,  "category": "maternal",   "description": "(WW/2) + Milk.", "evaluationSystem": "EPD" },
    { "key": "CEM",  "label": "Calving Ease Maternal",     "unit": "%",   "higherIsBetter": true,  "category": "maternal",   "description": "% unassisted births from the sire's daughters.", "evaluationSystem": "EPD" },
    { "key": "HP",   "label": "Heifer Pregnancy",          "unit": "%",   "higherIsBetter": true,  "category": "maternal",   "description": "Daughter pregnancy rate as yearling heifers.", "evaluationSystem": "EPD" },
    { "key": "Doc",  "label": "Docility",                  "unit": "%",   "higherIsBetter": true,  "category": "maternal",   "description": "Disposition score from chute/pen scoring.", "evaluationSystem": "EPD" },
    { "key": "CW",   "label": "Carcass Weight",            "unit": "lbs", "higherIsBetter": true,  "category": "carcass",    "description": "Hot carcass weight.", "evaluationSystem": "EPD" },
    { "key": "Marb", "label": "Marbling (USDA)",           "unit": "score","higherIsBetter": true, "category": "carcass",    "description": "USDA marbling score.", "evaluationSystem": "EPD" },
    { "key": "RE",   "label": "Ribeye Area",               "unit": "sq in","higherIsBetter": true, "category": "carcass",    "description": "Ribeye area at 12th rib.", "evaluationSystem": "EPD" },
    { "key": "Fat",  "label": "Fat Thickness",             "unit": "in",  "higherIsBetter": false, "category": "carcass",    "description": "12th rib backfat.", "evaluationSystem": "EPD" },
    { "key": "SC",   "label": "Scrotal Circumference",     "unit": "cm",  "higherIsBetter": true,  "category": "maternal",   "description": "Fertility indicator.", "evaluationSystem": "EPD" }
  ],
