  "notes": "AWA-AU transitioned from BREEDPLAN EBVs to Wagyu Breeding Values (WBVs) in February 2026. Retail Beef Yield (RBY) was discontinued. Net Feed Intake (NFI) and Marble Fineness (MFI) are Wagyu-specific traits. Uses the AUS-MEAT marble score scale (0-9+), NOT USDA marbling.",
  "traits": [
    { "key": "BWT",   "label": "Birth Weight",             "unit": "kg",      "higherIsBetter": false, "category": "calving",    "description": "Progeny birth weight WBV. Lower is favored for heifer bulls.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "W200",  "label": "200-Day Weight",           "unit": "kg",      "higherIsBetter": true,  "category": "growth",     "description": "Progeny weight at 200 days.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "W400",  "label": "400-Day Weight",           "unit": "kg",      "higherIsBetter": true,  "category": "growth",     "description": "Progeny weight at 400 days.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "W600",  "label": "600-Day Weight",           "unit": "kg",      "higherIsBetter": true,  "category": "growth",     "description": "Progeny weight at 600 days.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "MCW",   "label": "Mature Cow Weight",        "unit": "kg",      "higherIsBetter": false, "category": "maternal",   "description": "Mature daughter weight. Lower favors feed efficiency.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "Milk",  "label": "Milk",                     "unit": "kg",      "higherIsBetter": true,  "category": "maternal",   "description": "Daughter's milk contribution to calf 200-day weight.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "SC",    "label": "Scrotal Circumference",    "unit": "cm",      "higherIsBetter": true,  "category": "maternal",   "description": "Fertility indicator; correlates with daughter age at puberty.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "CWT",   "label": "Carcase Weight",           "unit": "kg",      "higherIsBetter": true,  "category": "carcass",    "description": "Hot carcase weight at harvest.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "EMA",   "label": "Eye Muscle Area",          "unit": "cm²",     "higherIsBetter": true,  "category": "carcass",    "description": "Ribeye cross-section area.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "MS",    "label": "Marble Score (AUS-MEAT)",  "unit": "score",   "higherIsBetter": true,  "category": "carcass",    "description": "AUS-MEAT marble score 0-9+. NOT the USDA scale.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "MFI",   "label": "Marble Fineness",          "unit": "index",   "higherIsBetter": true,  "category": "carcass",    "description": "Wagyu-unique trait measuring the texture/fineness of marbling fat — separate from marble score.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "P8Fat", "label": "Rump Fat (P8)",            "unit": "mm",      "higherIsBetter": false, "category": "carcass",    "description": "P8 rump fat depth. Trim-related — lower is favored.", "evaluationSystem": "WBV", "isWagyuSpecific": true },
    { "key": "NFI",   "label": "Net Feed Intake",          "unit": "kg/day",  "higherIsBetter": false, "category": "efficiency", "description": "Feed efficiency in long-fed systems. New in 2026. Lower = better.", "evaluationSystem": "WBV", "isWagyuSpecific": true }
  ],
